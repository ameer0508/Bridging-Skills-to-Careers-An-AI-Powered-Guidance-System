# Backend (Express) configuration. Copy to backend/.env for local development.
# Every value below has a working development default, so an empty file also runs.

# --- Server -------------------------------------------------------------------
PORT=5000
NODE_ENV=development
# Browser origin allowed by CORS
FRONTEND_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
# With a localhost URI in development the backend starts its own embedded MongoDB and
# persists it under backend/data/local_db (no MongoDB installation needed).
# Point this at a real server (e.g. mongodb+srv://...) to use that instead.
MONGODB_URI=mongodb://localhost:27017/skillbridge
# Set to true only to start with a temporary empty database when the persistent one
# cannot be opened. Data will not survive a restart.
# ALLOW_EPHEMERAL_DB=false

# --- AI service ---------------------------------------------------------------
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared credential for backend -> AI service calls. Must equal the value in ai/.env.
# Leave unset in development to use the built-in development key on both sides.
# Required (strong, unique) when NODE_ENV=production.
INTERNAL_SERVICE_KEY=

# How long the backend waits for the AI service, in milliseconds. Each is longer than the AI
# service's own provider timeout (GEMINI_TIMEOUT_SECONDS, 20 s) and shorter than the browser's wait.
# CHAT_AI_TIMEOUT_MS=25000
# INTERVIEW_AI_TIMEOUT_MS=12000
# INTERVIEW_QUESTION_AI_TIMEOUT_MS=15000

# --- Authentication -----------------------------------------------------------
# Leave unset in development to use built-in development keys.
# Required (strong, unique, different from each other) when NODE_ENV=production:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Uploads and logs ---------------------------------------------------------
# UPLOAD_DIR=uploads/resumes
# UPLOAD_MAX_SIZE=5242880
# LOG_DIR=logs

# --- Live jobs (RapidAPI JSearch) ----------------------------------------------
# Optional. Without a key the jobs pages show clearly labelled demo listings. With a key, a
# provider failure is shown as "unavailable"; demo listings are never substituted for live results.
# https://rapidapi.com/letscrape-6bef512/api/jsearch
RAPIDAPI_KEY=
# Zero-cost policy: JSearch is UNVERIFIED (docs/ZERO_COST_API_POLICY.md), so even with a key the
# backend makes no live call and reports BLOCKED_BY_POLICY with the labelled demo listings.

# OnJob.io live listings in the Career Lab comparison (A1). Off by default. Turn on only after
# reading https://onjob.io/for-job-boards/ and docs/MARKET_DATA_SOURCES.md: listings are
# republished with links back, held in memory for at most 24 hours, and never stored or counted.
SKILLBRIDGE_ENABLE_ONJOB=false
SKILLBRIDGE_ONJOB_FEED_TERMS_ACCEPTED=false
# Optional: refresh interval in hours (1-24, default 6) and fetches per day (1-24, default 8).
# ONJOB_REFRESH_HOURS=6
# ONJOB_MAX_FETCHES_PER_DAY=8

# Optional. General API rate limit per IP address per 15 minutes (default 1000).
# API_RATE_LIMIT_MAX=1000

# Optional. Where interview recordings are stored (default: voice-recordings/ beside UPLOAD_DIR)
# and how often the retention job runs, in hours (1 to 24, default 24).
# VOICE_RECORDING_DIR=
# VOICE_RETENTION_INTERVAL_HOURS=24

# Optional. Job searches per signed-in user per minute (1 to 600, default 30) and outbound
# searches to a live job provider per UTC day (0 to 10000, default 50; never unlimited).
# JOB_SEARCH_RATE_PER_MINUTE=30
# JOB_PROVIDER_DAILY_QUOTA=50
