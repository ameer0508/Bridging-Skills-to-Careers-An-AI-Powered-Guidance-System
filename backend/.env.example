# Server Configuration
PORT=5000
NODE_ENV=development

# Database Settings
# Replace with your actual local or hosted MongoDB URI
MONGODB_URI=mongodb://localhost:27017/skillbridge

# Downstream Services
AI_SERVICE_URL=http://127.0.0.1:8000

# Security and JWT Config
# In production, use strong 256-bit random secrets (e.g. openssl rand -base64 32)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Live Opportunity Intelligence Provider (RapidAPI JSearch)
# Obtain a free key at: https://rapidapi.com/letscrape-6bef512/api/jsearch
RAPIDAPI_KEY=
JSEARCH_API_KEY=
