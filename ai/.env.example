# AI service (FastAPI) configuration. Copy to ai/.env for local development.

# --- Server -------------------------------------------------------------------
PORT=8000
# Keep bound to localhost in development: only the backend calls this service.
HOST=127.0.0.1
ENV=development

# --- Service security ---------------------------------------------------------
# Shared credential the backend must send on every request. Must equal the value in
# backend/.env. Leave unset in development to use the built-in development key on both
# sides. Required (strong, unique) when ENV=production; the service refuses to start otherwise.
INTERNAL_SERVICE_KEY=

# Comma-separated browser origins allowed to call this service directly. Normally empty:
# browsers talk to the backend, never to this service. "*" is rejected.
CORS_ALLOWED_ORIGINS=

# Largest resume upload accepted, in bytes.
# MAX_UPLOAD_BYTES=5242880

# --- AI providers -------------------------------------------------------------
# Optional. Without a provider key, development uses a deterministic mock provider and
# production reports AI features as unavailable.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Optional, comma-separated. Models tried, in order, only if GEMINI_MODEL fails.
# Leave empty to never substitute another model. A fallback that answers is logged and
# reported in the response metadata.
# GEMINI_FALLBACK_MODELS=
