# Docker Compose configuration for SkillBridge.
# Copy to `.env` (never commit the copy) and fill in the required values.
#
# Generate each secret with:  openssl rand -base64 48
# (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")

# --- Required -----------------------------------------------------------------
# Signing keys for access and refresh tokens. Must be two different values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Shared credential between the backend and the internal AI service.
INTERNAL_SERVICE_KEY=

# --- Optional -----------------------------------------------------------------
# Google Gemini key for AI chat and AI-assisted parsing. Without it the AI chat
# replies with an "unavailable" notice; all deterministic features still work.
GEMINI_API_KEY=
# Override the Gemini model id if your key does not have access to the default.
GEMINI_MODEL=

# RapidAPI JSearch key for live job listings. Without it the jobs page shows
# clearly labelled sample listings.
RAPIDAPI_KEY=

# OnJob.io live listings in the Career Lab comparison (A1). Off by default. Turn on only after
# reading https://onjob.io/for-job-boards/ and docs/MARKET_DATA_SOURCES.md: listings are
# republished with links back, held in memory for at most 24 hours, and never stored or counted.
SKILLBRIDGE_ENABLE_ONJOB=false
SKILLBRIDGE_ONJOB_FEED_TERMS_ACCEPTED=false

# Public URL the browser uses to reach the frontend (used for backend CORS).
FRONTEND_URL=http://localhost:3000

JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
