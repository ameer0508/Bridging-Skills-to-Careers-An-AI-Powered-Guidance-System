# ==============================================================================
# SkillBridge Platform — Production Environment Configuration Template
# IMPORTANT: Never commit actual secret values to source control.
# Set these variables in your deployment environment (e.g. AWS ECS, Render, Vercel).
# ==============================================================================

# --- Server Core Settings ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://app.skillbridge.ai

# --- Database Connection ---
# Hosted MongoDB Replica Set URI with TLS enabled
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@cluster.mongodb.net/skillbridge_prod?retryWrites=true&w=majority

# --- Security & JWT Config ---
# Use strong 256-bit cryptographically secure random keys in production
JWT_ACCESS_SECRET=<SECURE_RANDOM_ACCESS_TOKEN_SECRET_KEY>
JWT_REFRESH_SECRET=<SECURE_RANDOM_REFRESH_TOKEN_SECRET_KEY>
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- Live Opportunity Intelligence Provider (RapidAPI JSearch) ---
# Backend-Only secret. NEVER expose in frontend build or client requests.
RAPIDAPI_KEY=<SECURE_RAPIDAPI_JSEARCH_KEY>

# --- Downstream Resume Intelligence Service ---
AI_SERVICE_URL=https://resume-parser-api.skillbridge.ai

# --- AI Provider Gateway Keys (Optional / Fallback) ---
GEMINI_API_KEY=<SECURE_GOOGLE_GEMINI_API_KEY>
OPENAI_API_KEY=<SECURE_OPENAI_API_KEY>

# --- Frontend Client Public Config (Injected at build time via VITE_) ---
# VITE_API_BASE_URL=https://api.skillbridge.ai/api/v1
